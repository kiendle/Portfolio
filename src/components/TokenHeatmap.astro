---
import usage from '../data/usage.json';
import {
  buildUsageCalendar,
  dayDescription,
  formatUpdatedAt,
  formatTokens,
  todayInTimeZone,
  usageYears,
  type UsageData,
} from '../lib/usage-calendar';

const data: UsageData = usage;
const today = todayInTimeZone(data.timeZone);
const years = usageYears(data.days, today);
const year = years[0];
const calendar = buildUsageCalendar(data.days, year, today);
const hasUsage = data.days.some((day) => day.date <= today);
const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const serialized = JSON.stringify(data).replace(/</g, '\\u003c');
---

<token-usage-calendar>
  <section class="usage-section" aria-labelledby="token-usage-heading">
    <header class="usage-heading">
      <h2 id="token-usage-heading">Token usage</h2>
      <label class="usage-year" for="token-usage-year">
        <span class="usage-sr-only">Usage year</span>
        <select id="token-usage-year" data-year aria-label="Usage year">
          {years.map((value) => <option value={value} selected={value === year}>{value}</option>)}
        </select>
      </label>
    </header>

    <div class="usage-card">
      <p class="usage-summary" data-summary aria-live="polite" aria-atomic="true" hidden={!hasUsage}>
        <span class="usage-sr-only" data-summary-label>{formatTokens(calendar.totalTokens)} in {year}</span>
        <strong class="usage-total" aria-hidden="true">
          <span data-total-fallback>{calendar.totalTokens.toLocaleString('en-US')}</span>
          <number-flow data-total-number hidden></number-flow>
        </strong>{' '}
        <span data-summary-context aria-hidden="true">{calendar.totalTokens === 1 ? 'token' : 'tokens'} in {year}</span>
      </p>
      <p class="usage-empty" data-empty hidden={hasUsage}>No collected usage yet.</p>

      <div id="token-usage-scroll" class="usage-scroll" data-calendar-shell hidden={!hasUsage}>
        <div class="usage-calendar" data-calendar style={`--weeks: ${calendar.weeks}`}>
          <div aria-hidden="true"></div>
          <div class="usage-months" data-months aria-hidden="true">
            {calendar.months.map((month) => (
              <span class="usage-month" style={`grid-column: ${month.week + 1}`}>{month.label}</span>
            ))}
          </div>
          <div class="usage-weekdays" aria-hidden="true">
            {weekdays.map((weekday, index) => <span>{index % 2 === 1 ? weekday.slice(0, 3) : ''}</span>)}
          </div>
          <div
            class="usage-grid"
            data-grid
            role="grid"
            aria-label={`Daily token usage for ${year}`}
            aria-describedby="token-usage-help"
            aria-rowcount="7"
            aria-colcount={calendar.weeks}
          >
            {calendar.rows.map((row, rowIndex) => (
              <div class="usage-row" role="row" aria-label={weekdays[rowIndex]} aria-rowindex={rowIndex + 1}>
                {row.map((day, week) => (
                  <div
                    class="usage-cell"
                    role="gridcell"
                    aria-colindex={week + 1}
                    aria-hidden={day ? undefined : 'true'}
                    style={`grid-column: ${week + 1}; grid-row: ${rowIndex + 1}`}
                  >
                    {day && (
                      <button
                        type="button"
                        class="usage-day"
                        data-index={day.index}
                        data-level={day.level}
                        aria-label={dayDescription(day)}
                        tabindex={day.index === calendar.days.length - 1 ? 0 : -1}
                      ></button>
                    )}
                  </div>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="usage-scrollbar" data-scrollbar hidden>
        <button
          class="usage-scroll-thumb"
          data-scroll-thumb
          type="button"
          role="scrollbar"
          aria-label="Scroll token usage"
          aria-controls="token-usage-scroll"
          aria-orientation="horizontal"
          aria-valuemin="0"
          aria-valuemax="0"
          aria-valuenow="0"
        ></button>
      </div>

      <div class="usage-key" data-key hidden={!hasUsage} aria-label="Color scale: less to more token usage">
        <span>Less</span>
        <span class="usage-swatches" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((level) => <i data-level={level}></i>)}
        </span>
        <span>More</span>
      </div>
      <p class="usage-updated">
        {data.updatedAt ? <>Updated <time datetime={data.updatedAt}>{formatUpdatedAt(data.updatedAt, data.timeZone)}</time></> : 'Not collected yet'}
        <span aria-hidden="true"> · </span><span>Dates in {data.timeZone.replaceAll('_', ' ')}</span>
      </p>
    </div>

    <p id="token-usage-help" class="usage-sr-only">
      Use the arrow keys to explore days. Home and End move across a weekday row.
      Control or Command plus Home and End move to the first or last day. Tap a day to inspect it.
    </p>
    <div id="token-usage-tooltip" class="usage-tooltip" data-tooltip popover="manual" role="tooltip">
      <strong data-tooltip-count></strong>
      <span data-tooltip-date></span>
    </div>
    <script is:inline type="application/json" data-usage set:html={serialized}></script>
  </section>
</token-usage-calendar>

<script>
  import 'number-flow';
  import type NumberFlow from 'number-flow';
  import {
    buildUsageCalendar,
    dayDescription,
    formatTokens,
    todayInTimeZone,
    usageYears,
    type UsageData,
  } from '../lib/usage-calendar';

  class TokenUsageCalendar extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.cleanup) return;

      const controller = new AbortController();
      const { signal } = controller;
      const data: UsageData = JSON.parse(this.querySelector('[data-usage]')!.textContent!);
      const select = this.querySelector<HTMLSelectElement>('[data-year]')!;
      const summary = this.querySelector<HTMLElement>('[data-summary]')!;
      const summaryLabel = summary.querySelector<HTMLElement>('[data-summary-label]')!;
      const summaryContext = summary.querySelector<HTMLElement>('[data-summary-context]')!;
      const totalFallback = summary.querySelector<HTMLElement>('[data-total-fallback]')!;
      const totalNumber = summary.querySelector<NumberFlow>('[data-total-number]')!;
      const empty = this.querySelector<HTMLElement>('[data-empty]')!;
      const shell = this.querySelector<HTMLElement>('[data-calendar-shell]')!;
      const canvas = this.querySelector<HTMLElement>('[data-calendar]')!;
      const scrollbar = this.querySelector<HTMLElement>('[data-scrollbar]')!;
      const thumb = this.querySelector<HTMLButtonElement>('[data-scroll-thumb]')!;
      const months = this.querySelector<HTMLElement>('[data-months]')!;
      const grid = this.querySelector<HTMLElement>('[data-grid]')!;
      const key = this.querySelector<HTMLElement>('[data-key]')!;
      const tooltip = this.querySelector<HTMLElement>('[data-tooltip]')!;
      const tooltipCount = tooltip.querySelector<HTMLElement>('[data-tooltip-count]')!;
      const tooltipDate = tooltip.querySelector<HTMLElement>('[data-tooltip-date]')!;
      const tooltipDateFormatter = new Intl.DateTimeFormat('en-US', {
        month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC',
      });
      const weekdays = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      let today = todayInTimeZone(data.timeZone);
      let year = Number(select.value);
      let calendar = buildUsageCalendar(data.days, year, today);
      let buttons: HTMLButtonElement[] = [];
      let activeIndex = 0;
      let focused: HTMLButtonElement | null = null;
      let tapped: HTMLButtonElement | null = null;
      let tooltipButton: HTMLButtonElement | null = null;
      let tooltipTimer: ReturnType<typeof setTimeout> | undefined;
      let scrollFrame: number | undefined;
      let positionedDate: string | undefined;
      let revealed = false;
      let statisticObserver: IntersectionObserver | undefined;

      totalNumber.locales = 'en-US';
      totalNumber.format = { maximumFractionDigits: 0 };
      totalNumber.trend = 1;
      // Keep the digit roll, but disable horizontal width/position transitions.
      totalNumber.spinTiming = totalNumber.transformTiming;
      totalNumber.transformTiming = { duration: 0 };
      totalNumber.animated = false;
      // Seed every digit column so the first reveal does not expand in from the sides.
      totalNumber.update(calendar.totalTokens > 0 ? 10 ** Math.floor(Math.log10(calendar.totalTokens)) : 0);
      totalNumber.animated = true;
      totalNumber.hidden = false;
      totalFallback.parentElement!.classList.add('is-animated');

      const revealTotal = () => {
        revealed = true;
        totalNumber.update(calendar.totalTokens);
        statisticObserver?.disconnect();
      };

      const hideTooltip = () => {
        if (tooltipTimer) clearTimeout(tooltipTimer);
        tooltip.classList.remove('is-scrubbing');
        tooltipButton?.removeAttribute('aria-describedby');
        tooltipButton = null;
        if (tooltip.matches(':popover-open')) tooltip.hidePopover();
      };

      const positionTooltip = () => {
        if (!tooltipButton || !tooltip.matches(':popover-open')) return;
        const anchor = tooltipButton.getBoundingClientRect();
        const viewport = shell.getBoundingClientRect();
        if (anchor.right < viewport.left || anchor.left > viewport.right || anchor.bottom < 0 || anchor.top > window.innerHeight) {
          hideTooltip();
          return;
        }
        const size = tooltip.getBoundingClientRect();
        const leftEdge = Math.max(12, viewport.left);
        const rightEdge = Math.min(window.innerWidth - 12, viewport.right);
        const left = Math.max(12, Math.min(Math.max(leftEdge, anchor.left + anchor.width / 2 - size.width / 2), rightEdge - size.width));
        const top = anchor.top >= size.height + 8 ? anchor.top - size.height - 6 : anchor.bottom + 6;
        tooltip.style.left = `${left}px`;
        tooltip.style.top = `${Math.max(8, Math.min(top, window.innerHeight - size.height - 8))}px`;
      };

      const showTooltip = (button: HTMLButtonElement, scrub = false) => {
        if (tooltipTimer) clearTimeout(tooltipTimer);
        const blurUpdate = scrub && tooltipButton !== button && tooltip.matches(':popover-open');
        tooltipButton?.removeAttribute('aria-describedby');
        tooltipButton = button;
        const day = calendar.days[Number(button.dataset.index)];
        tooltipCount.textContent = formatTokens(day.tokens);
        tooltipDate.textContent = tooltipDateFormatter.format(new Date(`${day.date}T00:00:00Z`));
        tooltip.classList.toggle('is-scrubbing', blurUpdate);
        if (blurUpdate) {
          tooltipTimer = setTimeout(() => tooltip.classList.remove('is-scrubbing'), 100);
        }
        button.setAttribute('aria-describedby', tooltip.id);
        if (!tooltip.matches(':popover-open')) tooltip.showPopover();
        positionTooltip();
      };

      const settleTooltip = () => {
        const button = focused ?? tapped;
        if (button) showTooltip(button);
        else hideTooltip();
      };

      const setActive = (button: HTMLButtonElement) => {
        if (buttons[activeIndex]) buttons[activeIndex].tabIndex = -1;
        activeIndex = Number(button.dataset.index);
        button.tabIndex = 0;
      };

      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let scrollRange = 0;
      let thumbTravel = 0;
      let drag: { id: number; x: number; y: number; scroll: number; time: number } | null = null;
      let liquidFrame = 0;
      let liquidTime = 0;
      let flow = 0;
      let flowSpeed = 0;
      let flowTarget = 0;
      let hovered = false;
      let lift = 0;
      let liftSpeed = 0;
      let liftTarget = 0;
      let grip = 0;
      let gripSpeed = 0;

      const animateThumb = (time: number) => {
        liquidFrame = 0;
        const dt = liquidTime ? Math.min((time - liquidTime) / 1000, 1 / 30) : 1 / 60;
        liquidTime = time;
        const gripTarget = drag ? 1 : hovered ? 0.35 : 0;
        flowSpeed += ((flowTarget - flow) * 200 - flowSpeed * 19) * dt;
        liftSpeed += ((liftTarget - lift) * 220 - liftSpeed * 22) * dt;
        gripSpeed += ((gripTarget - grip) * 300 - gripSpeed * 24) * dt;
        flow += flowSpeed * dt;
        lift += liftSpeed * dt;
        grip += gripSpeed * dt;
        flowTarget *= Math.exp(-6 * dt);
        const stretch = Math.min(1.4, Math.abs(flow));
        thumb.style.setProperty('--thumb-stretch', String(1 + stretch * 0.22));
        thumb.style.setProperty('--thumb-squash', String(1 - stretch * 0.22));
        thumb.style.setProperty('--thumb-bend', `${flow * -10}deg`);
        thumb.style.setProperty('--thumb-lift', `${lift}px`);
        thumb.style.setProperty('--thumb-height', `${6 + grip * 4}px`);
        if (Math.abs(flow) + Math.abs(flowSpeed) + Math.abs(flowTarget)
          + Math.abs(lift - liftTarget) + Math.abs(liftSpeed)
          + Math.abs(grip - gripTarget) + Math.abs(gripSpeed) > 0.003) {
          liquidFrame = requestAnimationFrame(animateThumb);
        } else {
          liquidTime = 0;
        }
      };

      const wakeThumb = () => {
        if (!reducedMotion.matches && !liquidFrame) liquidFrame = requestAnimationFrame(animateThumb);
      };
      thumb.addEventListener('pointerenter', () => { hovered = true; wakeThumb(); }, { signal });
      thumb.addEventListener('pointerleave', () => { hovered = false; wakeThumb(); }, { signal });

      const syncThumb = () => {
        const position = drag?.scroll ?? shell.scrollLeft;
        thumb.style.transform = `translateX(${scrollRange ? position / scrollRange * thumbTravel : 0}px)`;
        thumb.setAttribute('aria-valuenow', String(Math.round(shell.scrollLeft)));
      };

      const measureScrollbar = () => {
        scrollRange = Math.max(0, shell.scrollWidth - shell.clientWidth);
        scrollbar.hidden = shell.hidden || scrollRange <= 1;
        if (scrollbar.hidden) return;
        const width = scrollbar.clientWidth;
        const thumbWidth = Math.min(width, Math.max(44, width * shell.clientWidth / shell.scrollWidth));
        thumbTravel = width - thumbWidth;
        thumb.style.width = `${thumbWidth}px`;
        thumb.setAttribute('aria-valuemax', String(Math.round(scrollRange)));
        syncThumb();
      };

      thumb.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0 || thumbTravel <= 0) return;
        thumb.setPointerCapture(event.pointerId);
        drag = { id: event.pointerId, x: event.clientX, y: event.clientY, scroll: Math.max(0, Math.min(scrollRange, shell.scrollLeft)), time: event.timeStamp };
        thumb.classList.add('is-dragging');
        wakeThumb();
      }, { signal });
      thumb.addEventListener('pointermove', (event) => {
        if (!drag || event.pointerId !== drag.id) return;
        const deltaX = event.clientX - drag.x;
        // Discard travel beyond an end so even the first pixel back moves the thumb.
        drag.scroll = Math.max(0, Math.min(scrollRange, drag.scroll + deltaX / thumbTravel * scrollRange));
        shell.scrollLeft = drag.scroll;
        syncThumb();
        if (!reducedMotion.matches) {
          flowTarget = Math.max(-1.4, Math.min(1.4, deltaX / Math.max(1, event.timeStamp - drag.time) * 0.9));
          liftTarget = Math.max(-4, Math.min(4, (event.clientY - drag.y) * 0.24));
          wakeThumb();
        }
        drag.x = event.clientX;
        drag.time = event.timeStamp;
      }, { signal });
      const endDrag = (event: PointerEvent) => {
        if (event.pointerId !== drag?.id) return;
        drag = null;
        syncThumb();
        flowTarget = 0;
        liftTarget = 0;
        wakeThumb();
        thumb.classList.remove('is-dragging');
        if (thumb.hasPointerCapture(event.pointerId)) thumb.releasePointerCapture(event.pointerId);
      };
      thumb.addEventListener('pointerup', endDrag, { signal });
      thumb.addEventListener('pointercancel', endDrag, { signal });
      thumb.addEventListener('lostpointercapture', endDrag, { signal });
      thumb.addEventListener('keydown', (event) => {
        let next = shell.scrollLeft;
        switch (event.key) {
          case 'ArrowLeft': next -= 40; break;
          case 'ArrowRight': next += 40; break;
          case 'PageUp': next -= shell.clientWidth; break;
          case 'PageDown': next += shell.clientWidth; break;
          case 'Home': next = 0; break;
          case 'End': next = scrollRange; break;
          default: return;
        }
        event.preventDefault();
        shell.scrollLeft = Math.max(0, Math.min(scrollRange, next));
        syncThumb();
      }, { signal });
      shell.addEventListener('scroll', syncThumb, { passive: true, signal });
      const scrollbarObserver = new ResizeObserver(measureScrollbar);
      shell.classList.add('has-liquid-scrollbar');
      scrollbarObserver.observe(shell);
      scrollbarObserver.observe(canvas);

      const render = () => {
        const retainFocus = grid.contains(document.activeElement);
        const previousDate = retainFocus ? calendar.days[activeIndex]?.date : undefined;
        hideTooltip();
        focused = tapped = null;
        const years = usageYears(data.days, today);
        if (!years.includes(year)) year = years[0];
        select.replaceChildren(...years.map((value) => new Option(String(value), String(value), false, value === year)));
        calendar = buildUsageCalendar(data.days, year, today);
        const hasUsage = data.days.some((day) => day.date <= today);
        summary.hidden = !hasUsage;
        empty.hidden = hasUsage;
        shell.hidden = !hasUsage;
        key.hidden = !hasUsage;
        summaryLabel.textContent = `${formatTokens(calendar.totalTokens)} in ${year}`;
        summaryContext.textContent = `${calendar.totalTokens === 1 ? 'token' : 'tokens'} in ${year}`;
        totalFallback.textContent = calendar.totalTokens.toLocaleString('en-US');
        if (revealed) totalNumber.update(calendar.totalTokens);
        canvas.style.setProperty('--weeks', String(calendar.weeks));
        grid.setAttribute('aria-label', `Daily token usage for ${year}`);
        grid.setAttribute('aria-colcount', String(calendar.weeks));
        months.replaceChildren(...calendar.months.map((month) => {
          const label = document.createElement('span');
          label.className = 'usage-month';
          label.style.gridColumn = String(month.week + 1);
          label.textContent = month.label;
          return label;
        }));
        buttons = [];
        const previousIndex = previousDate ? calendar.days.findIndex((day) => day.date === previousDate) : -1;
        activeIndex = previousIndex >= 0 ? previousIndex : calendar.days.length - 1;
        const rows = calendar.rows.map((row, rowIndex) => {
          const element = document.createElement('div');
          element.className = 'usage-row';
          element.setAttribute('role', 'row');
          element.setAttribute('aria-label', weekdays[rowIndex]);
          element.setAttribute('aria-rowindex', String(rowIndex + 1));
          row.forEach((day, week) => {
            const cell = document.createElement('div');
            cell.className = 'usage-cell';
            cell.setAttribute('role', 'gridcell');
            cell.setAttribute('aria-colindex', String(week + 1));
            cell.style.gridColumn = String(week + 1);
            cell.style.gridRow = String(rowIndex + 1);
            if (day) {
              const button = document.createElement('button');
              button.type = 'button';
              button.className = 'usage-day';
              button.dataset.index = String(day.index);
              button.dataset.level = String(day.level);
              button.setAttribute('aria-label', dayDescription(day));
              button.tabIndex = day.index === activeIndex ? 0 : -1;
              buttons[day.index] = button;
              cell.append(button);
            } else cell.setAttribute('aria-hidden', 'true');
            element.append(cell);
          });
          return element;
        });
        grid.replaceChildren(...rows);
        measureScrollbar();
        if (retainFocus) buttons[activeIndex]?.focus({ preventScroll: true });

        const latestDate = calendar.days[calendar.days.length - 1]?.date;
        if (latestDate !== positionedDate) {
          positionedDate = latestDate;
          if (scrollFrame !== undefined) window.cancelAnimationFrame(scrollFrame);
          scrollFrame = window.requestAnimationFrame(() => {
            scrollFrame = undefined;
            const latest = buttons[calendar.days.length - 1];
            const overflow = shell.scrollWidth - shell.clientWidth;
            if (!latest || shell.hidden || overflow <= 0 || grid.contains(document.activeElement)) return;
            // Move only this scroller, without focusing a day or scrolling the page.
            const viewport = shell.getBoundingClientRect();
            const target = shell.scrollLeft + latest.getBoundingClientRect().right
              - viewport.right + parseFloat(getComputedStyle(shell).paddingRight);
            shell.scrollLeft = Math.max(0, Math.min(overflow, target));
          });
        }
      };

      select.addEventListener('change', () => {
        year = Number(select.value);
        render();
      }, { signal });

      grid.addEventListener('focusin', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.usage-day');
        if (!button) return;
        focused = button.matches(':focus-visible') ? button : null;
        setActive(button);
        button.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        if (focused) showTooltip(button);
      }, { signal });
      grid.addEventListener('focusout', () => {
        focused = tapped = null;
        settleTooltip();
      }, { signal });
      grid.addEventListener('pointerover', (event) => {
        if (event.pointerType === 'touch') return;
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.usage-day');
        if (!button) return;
        showTooltip(button, true);
      }, { signal });
      grid.addEventListener('pointerout', (event) => {
        if (event.pointerType === 'touch') return;
        // Keep one popover through cell gaps instead of closing/reopening it.
        if (event.relatedTarget instanceof Node && grid.contains(event.relatedTarget)) {
          if (tooltipTimer) clearTimeout(tooltipTimer);
          tooltip.classList.add('is-scrubbing');
          tooltipTimer = setTimeout(settleTooltip, 100);
          return;
        }
        settleTooltip();
      }, { signal });
      grid.addEventListener('pointerup', (event) => {
        if (event.pointerType !== 'touch') return;
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.usage-day');
        if (!button) return;
        // Settle the previous day's focusout before opening the tapped day's details.
        button.focus({ preventScroll: true });
        tapped = button;
        setActive(button);
        showTooltip(button);
      }, { signal });
      grid.addEventListener('keydown', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.usage-day');
        if (!button) return;
        const day = calendar.days[Number(button.dataset.index)];
        let next = day.index;
        switch (event.key) {
          case 'ArrowLeft': next -= 7; break;
          case 'ArrowRight': next += 7; break;
          case 'ArrowUp': if (day.weekday > 0) next--; break;
          case 'ArrowDown': if (day.weekday < 6) next++; break;
          case 'Home': next = event.ctrlKey || event.metaKey ? 0 : day.index % 7; break;
          case 'End': next = event.ctrlKey || event.metaKey ? buttons.length - 1 : day.index + Math.floor((buttons.length - 1 - day.index) / 7) * 7; break;
          case 'Escape':
            event.preventDefault();
            tapped = null;
            hideTooltip();
            return;
          default: return;
        }
        event.preventDefault();
        const target = buttons[next];
        if (!target) return;
        setActive(target);
        target.focus({ preventScroll: true });
        target.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        showTooltip(target);
      }, { signal });
      document.addEventListener('pointerdown', (event) => {
        const target = event.target as Node;
        if (grid.contains(target) || tooltip.contains(target)) return;
        tapped = null;
        hideTooltip();
      }, { signal });
      window.addEventListener('scroll', positionTooltip, { capture: true, passive: true, signal });
      window.addEventListener('resize', positionTooltip, { passive: true, signal });

      const refreshToday = () => {
        const current = todayInTimeZone(data.timeZone);
        if (current === today) return;
        today = current;
        render();
      };
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) refreshToday();
      }, { signal });
      const dayBoundaryCheck = window.setInterval(() => {
        if (!document.hidden) refreshToday();
      }, 60_000);

      // A static build may have been generated before the current local day.
      render();
      if ('IntersectionObserver' in window) {
        statisticObserver = new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) revealTotal();
        }, { threshold: 0.5 });
        statisticObserver.observe(summary);
      } else {
        revealTotal();
      }
      this.cleanup = () => {
        controller.abort();
        statisticObserver?.disconnect();
        scrollbarObserver.disconnect();
        cancelAnimationFrame(liquidFrame);
        shell.classList.remove('has-liquid-scrollbar');
        scrollbar.hidden = true;
        totalNumber.animated = false;
        window.clearInterval(dayBoundaryCheck);
        if (scrollFrame !== undefined) window.cancelAnimationFrame(scrollFrame);
        hideTooltip();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get('token-usage-calendar')) {
    customElements.define('token-usage-calendar', TokenUsageCalendar);
  }
</script>

<style>
  token-usage-calendar {
    display: block;
    min-width: 0;
    --usage-0: #edf1ec;
    --usage-1: #9ced68;
    --usage-2: #4ade32;
    --usage-3: #16c343;
    --usage-4: #00a83e;
